{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marswalk:route-request:1.1",
  "title": "PROPOSED Marswalk route request 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "site_id", "terrain_revision", "client_request_id", "start", "stops", "custom_stops", "stop_order", "return_to_habitat", "preset", "start_time_min", "max_duration_min"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "site_id": {"type": "string", "minLength": 1},
    "terrain_revision": {"type": "string", "minLength": 1},
    "client_request_id": {"type": "string", "minLength": 1},
    "start": {"$ref": "#/$defs/cell"},
    "stops": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "custom_stops": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/customStop"}},
    "stop_order": {"enum": ["request", "optimize"]},
    "return_to_habitat": {"type": "boolean"},
    "preset": {"enum": ["safe", "fast", "science"]},
    "start_time_min": {"type": "number", "minimum": 0},
    "max_duration_min": {"type": "number", "minimum": 30, "maximum": 1440}
  },
  "$defs": {
    "cell": {"type": "object", "required": ["row", "col"], "additionalProperties": false, "properties": {"row": {"type": "integer", "minimum": 0}, "col": {"type": "integer", "minimum": 0}}},
    "customStop": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "row", "col", "tag", "dwell_min"],
      "properties": {
        "id": {"type": "string", "pattern": "^note_[A-Za-z0-9_-]+$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 60},
        "row": {"type": "integer", "minimum": 0}, "col": {"type": "integer", "minimum": 0},
        "tag": {"enum": ["waypoint", "science", "hazard", "shelter"]},
        "dwell_min": {"type": "number", "minimum": 0, "maximum": 1440}
      }
    }
  }
}
